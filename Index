  if(D.mode==="find"){
    body='<p class="hint">Bar 1 is I. Pick the chord you hear in each of the next three bars.</p>';
    for(let i=0;i<3;i++){const correct=q.tpl[i+1];body+='<div class="barpick"><span class="label">Bar '+(i+2)+'</span><div class="opts tight">'+q.opts.map((o,j)=>{let cls="",disabled="";if(q.checked){disabled=" disabled";if(o===correct)cls=" ok";else if(q.pick[i]===o)cls=" no";}return '<button class="opt'+cls+'" data-act="dpick" data-bar="'+i+'" data-i="'+j+'"'+disabled+' aria-pressed="'+(q.pick[i]===o)+'">'+esc(o)+'</button>';}).join("")+'</div></div>';}
    if(!q.checked)body+='<div class="row"><button class="btn" data-act="dcheck"'+(q.pick.some(x=>x==null)?" disabled":"")+'>Check answers</button></div>';
    else{const right=q.tpl.slice(1).filter((n,i)=>q.pick[i]===n).length;body+='<div class="fb '+(right===3?"ok":"no")+'"><b>'+right+' of 3 right</b><p>The loop was '+esc(q.tpl.join(" – "))+': '+esc(q.tpl.map(n=>chordLabel(mod12(q.tonic+CH[n].d),CH[n].q)).join(" – "))+' in '+esc(keyName("C",mod12(q.tonic)))+'.</p></div>';}
  }else{
    body='<div class="opts">'+q.opts.map((o,i)=>{let cls="";if(D.done){if(i===q.ans)cls=" ok";else if(i===D.ans)cls=" no";}return '<button class="opt'+cls+'" data-act="danswer" data-i="'+i+'"'+(D.done?" disabled":"")+'>'+esc(o)+'</button>';}).join("")+'</div>';
    if(D.done)body+=feedbackHtml();
  }
  return h+'<div class="card stack"><div class="qhead"><span class="label">'+esc(m.name)+' · question '+(D.n+1)+' of '+m.total+'</span><span class="label">Score '+D.score+'</span></div><div class="qbar" aria-hidden="true"><i style="width:'+Math.round(100*D.n/m.total)+'%"></i></div>'+
   '<div class="row"><button class="btn" data-act="dhear">Hear it again</button></div>'+body+
   (D.done?'<div class="row"><button class="btn" data-act="dnext">'+(D.n+1>=m.total?"Finish round":"Next question")+'</button></div>':'')+
   '<div class="row"><button class="btn ghost small" data-act="dquit">Stop this round</button></div></div>';
}

/* ---------- events ---------- */
document.addEventListener("click",e=>{
  const kbk=e.target.closest&&e.target.closest("rect[data-m]");if(kbk){auditionNote(+kbk.getAttribute("data-m"));return;}
  const t=e.target.closest("[data-act]");if(!t||t.disabled)return;const a=t.dataset.act;if(a==="shift"||a==="feel")return;
  const s=(UI.tab==="learn"&&UI.view==="song")?cur():null;
  switch(a){
    case"timer":toggleTimer();break;
    case"addmin":{const k=todayKey();P.days[k]=Math.max(0,(P.days[k]||0)+(+t.dataset.n)*60);persist();paintTimer();break;}
    case"tab":stopPlay();UI.tab=t.dataset.tab;render();break;
    case"level":UI.level=+t.dataset.n;render();break;
    case"unlock":P.unlock[t.dataset.n]=true;persist();render();break;
    case"open":{stopPlay();UI.songId=t.dataset.id;UI.view="song";UI.tab="learn";UI.stage=t.dataset.stage?+t.dataset.stage:1;UI.bar=0;UI.peek=false;UI.shift=0;UI.loop="all";const so=cur();UI.smooth=so.level>0;UI.feel=so.feel||"block";UI.melody=true;UI.mel=null;render();window.scrollTo({top:0});break;}
    case"home":stopPlay();UI.view="home";render();break;
    case"stage":UI.stage=+t.dataset.n;UI.peek=false;render();break;
    case"peek":UI.peek=!UI.peek;paintLive();break;
    case"play":if(A.playing)stopPlay();else startPlay();break;
    case"speed":UI.speed=+t.dataset.n;render();break;
    case"loop":UI.loop="all";render();break;
    case"loopbar":UI.loop=UI.loop==="bar"?"all":"bar";render();break;
    case"click":UI.click=!UI.click;render();break;
    case"melody":UI.melody=!UI.melody;render();break;
    case"smooth":UI.smooth=!UI.smooth;render();break;
    case"names":UI.names=!UI.names;render();break;
    case"orig":UI.shift=s.origShift;render();break;
    case"bar":UI.bar=+t.dataset.i;UI.mel=null;paintLive();if(!A.playing)auditionBar(UI.bar);break;
    case"clean":{const rec=P.songs[s.id]||(P.songs[s.id]={clean:[]});const k=todayKey();const i=rec.clean.indexOf(k);if(i>=0)rec.clean.splice(i,1);else rec.clean.push(k);persist();render();break;}
    case"bcopy":copyBackup();break;
    case"brestore":restoreBackup();break;
    case"dmode":stopPlay();D.mode=t.dataset.id;D.active=false;D.summary=null;render();break;
    case"ddiff":D.diff=t.dataset.d;render();break;
    case"dstart":drillStart();break;
    case"dhear":drillPlay();break;
    case"danswer":drillAnswer(+t.dataset.i);break;
    case"dpick":drillPick(+t.dataset.bar,+t.dataset.i);break;
    case"dcheck":drillCheck();break;
    case"dnext":drillNext();break;
    case"dquit":D.active=false;D.summary=null;if(A.ctx)newMaster();render();break;
  }
});
document.addEventListener("input",e=>{if(e.target.id==="bin"&&UI.armed){UI.armed=false;const b=$("#brbtn");if(b)b.textContent="Restore";const m=$("#bmsg");if(m)m.textContent="";}});
document.addEventListener("change",e=>{
  if(e.target.id==="shiftsel"){UI.shift=+e.target.value;render();}
  if(e.target.id==="feelsel"){UI.feel=e.target.value;render();}
});

/* ---------- boot ---------- */
try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist();}catch(e){}loadLocal();renderTimer();paintStreak();render();initCloud();
</script>


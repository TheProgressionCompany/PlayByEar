  for(let m=lo;m<=hi;m++){if(!isBlack(m))continue;const x=(whiteIdx[m-1]+1)*W-BW/2;const cls=rhSet[m]!=null?" rh":lhSet[m]?" lh":"";
    svg+='<rect class="bk'+cls+'" data-m="'+m+'" x="'+x+'" y="2" width="'+BW+'" height="'+BH+'" rx="3"/>';

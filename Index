<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Play by Ear">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#F1F3F7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0F141B" media="(prefers-color-scheme: dark)">
<meta name="description" content="Daily piano practice by ear: songs in levels, chord shapes with finger numbers, ear drills and a 30-minute timer.">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" href="./apple-touch-icon.png">
<link rel="icon" type="image/png" href="./icon-192.png">
<style>
html{color-scheme:light;-webkit-text-size-adjust:100%;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0}
[hidden]{display:none!important}
img{max-width:100%}
</style>
<title>Play by Ear</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600&display=swap">
<style>
/* Layout: one column. Practice timer on top, then two tabs (Learn, Ear drills). Learn shows levels and songs, or one song with chord strip, keyboard and controls. */
:root{
  --bg:#F1F3F7; --surface:#FFFFFF; --surface-2:#E9EDF3; --ink:#15202B; --muted:#586575; --line:#D5DBE4;
  --rh:#2A62D9; --rh-tint:#CFE0FF; --lh:#B96A00; --lh-tint:#FFE0B0; --on-hand:#FFFFFF;
  --good:#17805A; --good-tint:#D6F1E5; --bad:#B3322A; --bad-tint:#F8DAD7; --warn:#9A5B00;
  --key-white:#FCFDFF; --key-black:#1B2431; --key-line:#8B97A8; --key-text:#586575;
  --font-display:"Bricolage Grotesque","Avenir Next","Segoe UI",system-ui,sans-serif;
  --font-body:"Figtree","Segoe UI",system-ui,-apple-system,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F141B; --surface:#171F29; --surface-2:#212B37; --ink:#E7ECF2; --muted:#9AA7B6; --line:#2B3746;
    --rh:#7BA9FF; --rh-tint:#23406F; --lh:#F3AE45; --lh-tint:#5A3C0E; --on-hand:#0E1319;
    --good:#4FC58F; --good-tint:#15392B; --bad:#FF8A80; --bad-tint:#4A2320; --warn:#F3AE45;
    --key-white:#E6EBF1; --key-black:#0B1017; --key-line:#5B6878; --key-text:#3D4856;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F141B; --surface:#171F29; --surface-2:#212B37; --ink:#E7ECF2; --muted:#9AA7B6; --line:#2B3746;
  --rh:#7BA9FF; --rh-tint:#23406F; --lh:#F3AE45; --lh-tint:#5A3C0E; --on-hand:#0E1319;
  --good:#4FC58F; --good-tint:#15392B; --bad:#FF8A80; --bad-tint:#4A2320; --warn:#F3AE45;
  --key-white:#E6EBF1; --key-black:#0B1017; --key-line:#5B6878; --key-text:#3D4856;
  color-scheme:dark;
}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:15px;line-height:1.5;padding-inline:16px;padding-block:20px 48px}
*{box-sizing:border-box}
.app{max-width:980px;margin-inline:auto;display:flex;flex-direction:column;gap:16px}
button,.opt,.chip,.bar{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
textarea{width:100%;font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--surface-2);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 10px;resize:vertical}
details.card summary{font-weight:600}
.app>*,#view>*,.card>*{min-width:0;max-width:100%}
#view{display:flex;flex-direction:column;gap:16px;min-width:0}
.card{min-width:0}
h1,h2,h3{font-family:var(--font-display);margin:0;line-height:1.15;text-wrap:balance}
h1{font-size:30px;font-weight:800;letter-spacing:-.01em}
h2{font-size:22px;font-weight:800}
h3{font-size:16px;font-weight:600}
p{margin:0}
button,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--rh);outline-offset:2px}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}
.sub{color:var(--muted)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px}
.stack{display:grid;gap:12px;grid-template-columns:minmax(0,1fr)}
.label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.hint{color:var(--muted);font-size:14px}
.btn{background:var(--rh);color:var(--on-hand);border:0;border-radius:10px;padding:10px 18px;font-weight:600;min-height:44px}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.small{padding:6px 12px;min-height:36px;font-size:14px}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.chip{background:var(--surface-2);border:1px solid transparent;border-radius:999px;padding:7px 14px;font-weight:500;min-height:38px}
.chip[aria-pressed="true"],.chip[aria-selected="true"]{background:var(--ink);color:var(--bg)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.streak{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.dots{display:flex;gap:5px}
.dot{width:12px;height:12px;border-radius:50%;background:var(--surface-2);border:1px solid var(--line)}
.dot.on{background:var(--good);border-color:var(--good)}
.dot.today{outline:2px solid var(--ink);outline-offset:1px}
.nav{display:flex;gap:8px;flex-wrap:wrap}
.nav .chip{flex:1 1 0;min-width:120px;text-align:center;font-weight:600}
/* timer */
.trow{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.tnum{font-family:var(--font-display);font-size:38px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}
.tgoal{color:var(--muted);font-variant-numeric:tabular-nums}
.tbar{display:grid;grid-template-columns:5fr 15fr 10fr;gap:4px;margin-top:12px}
.seg{height:10px;border-radius:5px;background:var(--surface-2);overflow:hidden}
.seg i{display:block;height:100%;background:var(--good);width:0}
.tlabels{display:grid;grid-template-columns:5fr 15fr 10fr;gap:4px;font-size:12px;color:var(--muted);margin-top:4px}
.tlabels span.now{color:var(--ink);font-weight:600}
/* home */
.levels{display:flex;gap:8px;overflow-x:auto;padding-block:8px;margin-block:4px}
.levels .chip{white-space:nowrap}
.songs{display:grid;gap:10px;grid-template-columns:minmax(0,1fr)}
.song{display:flex;justify-content:space-between;align-items:center;gap:12px;text-align:left;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.song:hover{border-color:var(--rh)}
.song .t{font-weight:600;font-size:16px}
.song .m{color:var(--muted);font-size:13px}
.pill{font-size:12px;font-weight:600;border-radius:999px;padding:3px 10px;background:var(--surface-2);white-space:nowrap}
.pill.good{background:var(--good-tint);color:var(--good)}
.pill.next{background:var(--rh-tint);color:var(--ink)}
.prog{display:flex;gap:4px;margin-top:6px}
.prog i{width:18px;height:6px;border-radius:3px;background:var(--surface-2)}
.prog i.on{background:var(--good)}
.next-card{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-color:var(--rh)}
.rev{display:grid;gap:8px}
.rev .song{padding:10px 14px}
/* song */
.meta{display:flex;gap:8px;flex-wrap:wrap}
.stages{display:flex;gap:8px;flex-wrap:wrap}
.strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:8px}
.bar{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 6px;text-align:center;min-height:68px}
.bar b{display:block;font-family:var(--font-display);font-size:21px;font-weight:800;line-height:1.1}
.bar small{display:block;color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
.bar[aria-pressed="true"]{border-color:var(--rh);background:var(--rh-tint)}
.kbscroll{overflow-x:auto;border-radius:10px;max-width:100%}
.kb{display:block;width:100%;min-width:540px;height:auto}
.kb .wk{fill:var(--key-white);stroke:var(--key-line);stroke-width:1}
.kb .bk{fill:var(--key-black);stroke:var(--key-black)}
.kb .wk.rh{fill:var(--rh-tint)} .kb .wk.lh{fill:var(--lh-tint)}
.kb .bk.rh{fill:var(--rh)} .kb .bk.lh{fill:var(--lh)}
.kb .nm{font-size:13px;fill:var(--key-text);text-anchor:middle;font-family:var(--font-body);pointer-events:none}
.kb .nm.c{font-weight:700}
.kb .badge.rh{fill:var(--rh)} .kb .badge.lh{fill:var(--lh)}
.kb .fn{font-size:15px;font-weight:700;fill:var(--on-hand);text-anchor:middle;dominant-baseline:central;pointer-events:none;font-family:var(--font-body)}
.kb .mid{fill:var(--ink)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:6px;vertical-align:-1px}
.conceal{display:flex;align-items:center;justify-content:center;min-height:120px;text-align:center;color:var(--muted);background:var(--surface-2);border-radius:10px;padding:16px}
.explain{display:grid;gap:10px;grid-template-columns:minmax(0,1fr)}
.explain .big{font-family:var(--font-display);font-size:26px;font-weight:800}
.notes{display:flex;gap:8px;flex-wrap:wrap}
.note{background:var(--surface-2);border-radius:8px;padding:4px 10px;font-weight:600;font-variant-numeric:tabular-nums}
dl.fing{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;margin:0}
dl.fing dt{color:var(--muted)} dl.fing dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums}
.sbar{position:fixed;left:0;right:0;bottom:0;z-index:20;display:none;justify-content:center;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:var(--surface);border-top:1px solid var(--line);box-shadow:0 -4px 14px rgba(0,0,0,.12)}
.sbar.on{display:flex}.sbar .btn{min-width:160px}
.controls{display:grid;gap:12px;grid-template-columns:minmax(0,1fr)}
.play{font-size:17px;min-width:120px}
.field{display:flex;flex-direction:column;gap:4px}
select{background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:8px 10px;min-height:40px;max-width:100%}
details summary{cursor:pointer;font-weight:600}
details .row{margin-top:12px}
ol.steps{margin:8px 0 0;padding-left:20px;display:grid;gap:4px}
.back{align-self:flex-start}
.locked{text-align:center;display:grid;gap:10px;justify-items:center;padding:24px}
.tag{font-size:12px;color:var(--muted)}
.clean{display:flex;gap:12px;align-items:center;flex-wrap:wrap;justify-content:space-between}
.feelbox{background:var(--surface-2);border-radius:10px;padding:12px}
a{color:var(--rh)}
/* drills */
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px}
.opts.tight{grid-template-columns:repeat(auto-fill,minmax(64px,1fr))}
.opt{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:12px 10px;font-weight:600;min-height:48px;text-align:center}
.opt:hover:not([disabled]){border-color:var(--rh)}
.opt[aria-pressed="true"]{border-color:var(--rh);background:var(--rh-tint)}
.opt.ok{background:var(--good-tint);border-color:var(--good);color:var(--ink)}
.opt.no{background:var(--bad-tint);border-color:var(--bad);color:var(--ink)}
.fb{border-radius:10px;padding:12px;display:grid;gap:6px}
.fb.ok{background:var(--good-tint)} .fb.no{background:var(--bad-tint)}
.fb b{font-family:var(--font-display);font-size:18px}
.qhead{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center}
.qbar{height:8px;border-radius:4px;background:var(--surface-2);overflow:hidden}
.qbar i{display:block;height:100%;background:var(--rh)}
.dmodes{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.dmode{text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:grid;gap:4px}
.dmode[aria-pressed="true"]{border-color:var(--rh);background:var(--rh-tint)}
.dmode b{font-family:var(--font-display);font-size:17px}
.dmode span{font-size:13px;color:var(--muted)}
.barpick{display:grid;gap:6px}
.big-score{font-family:var(--font-display);font-size:40px;font-weight:800}
@media (prefers-reduced-motion:no-preference){.bar,.song,.opt{transition:border-color .15s,background .15s}}
</style>
</head>
<body>


<div class="app">
  <header class="top">
    <div>
      <h1>Play by Ear</h1>
      <p class="sub">One song at a time. Thirty minutes a day.</p>
    </div>
    <div class="streak" id="streak" aria-live="polite"></div>
  </header>
  <section class="card" id="timer" aria-label="Daily practice timer"></section>
  <nav class="nav" id="nav" aria-label="Sections"></nav>
  <main id="view"></main>
</div>

<script>
/*THEORY*/
const SHARP=['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
const FLAT=['C','D♭','D','E♭','E','F','G♭','G','A♭','A','B♭','B'];
const NOTE_PC={C:0,D:2,E:4,F:5,G:7,A:9,B:11};
const LET=['C','D','E','F','G','A','B'];
const Q={'':[0,4,7],'m':[0,3,7],'7':[0,4,7,10],'maj7':[0,4,7,11],'m7':[0,3,7,10],'sus4':[0,5,7],'add9':[0,4,7,2],'6':[0,4,7,9],'dim':[0,3,6]};
const STEPS={0:0,2:1,3:2,4:2,5:3,6:4,7:4,9:5,10:6,11:6};
const ROM_MAJ=['I','♭II','II','♭III','III','IV','♭V','V','♭VI','VI','♭VII','VII'];
const ROM_MIN=['I','♭II','II','III','♯III','IV','♭V','V','VI','♯VI','VII','♯VII'];
const DEG=['1','♭2','2','♭3','3','4','♭5','5','♭6','6','♭7','7'];
const mod12=n=>((n%12)+12)%12;
const minorish=q=>q==='m'||q==='m7'||q==='dim';
function notePc(s){const m=/^([A-G])([#b♯♭]?)$/.exec(s);if(!m)throw new Error('bad note '+s);const a=m[2];return mod12(NOTE_PC[m[1]]+((a==='#'||a==='♯')?1:(a==='b'||a==='♭')?-1:0));}
function parseChord(s){const parts=String(s).split('/');const m=/^([A-G][#b]?)(.*)$/.exec(parts[0]);if(!m)throw new Error('bad chord '+s);const q=m[2];if(!Object.prototype.hasOwnProperty.call(Q,q))throw new Error('bad quality '+s);const root=notePc(m[1]);return{root,q,bass:parts[1]?notePc(parts[1]):root,slash:!!parts[1]};}
function keyInfo(key){const minor=/m$/.test(key);return{tonic:notePc(key.replace(/m$/,'')),minor};}
function keyUsesFlats(tonic,minor){return(minor?[2,7,0,5,10,3]:[5,10,3,8,1,6]).includes(mod12(tonic));}
function keyName(key,shift){const k=keyInfo(key);const t=mod12(k.tonic+shift);return(keyUsesFlats(t,k.minor)?FLAT:SHARP)[t]+(k.minor?' minor':' major');}
function spellChord(rootName,q,rootPc){const li=LET.indexOf(rootName[0]);return Q[q].map(iv=>{const L=LET[(li+STEPS[iv])%7];const pc=mod12(rootPc+iv);const d=((pc-NOTE_PC[L]+18)%12)-6;return{pc,name:L+(d===0?'':d===1?'♯':d===-1?'♭':d>0?'♯♯':'♭♭')};});}
function romanFor(chordStr,tonic,minor){const c=parseChord(chordStr);let base=(minor?ROM_MIN:ROM_MAJ)[mod12(c.root-tonic)];if(minorish(c.q))base=base.replace(/[IV]+/,m=>m.toLowerCase());const suf={'':'','m':'','7':'7','maj7':'maj7','m7':'7','sus4':'sus4','add9':'add9','6':'6','dim':'°'}[c.q];return base+suf+(c.slash?'/'+DEG[mod12(c.bass-tonic)]:'');}
function fingersFor(notes){const n=notes.length;if(n===3){return(notes[2]-notes[1]>=5)?[1,2,5]:[1,3,5];}if(n===4)return[1,2,3,5];return notes.map((_,i)=>i+1);}
function voice(root,q,smooth,prevMean){
  const pcs=Q[q].map(i=>mod12(root+i));const invs=smooth?pcs.map((_,k)=>k):[0];
  const build=(limit)=>{const out=[];for(const k of invs){const order=pcs.slice(k).concat(pcs.slice(0,k));for(let low=60;low<=71;low++){if(mod12(low)!==order[0])continue;const notes=[low];for(let i=1;i<order.length;i++){let n=notes[i-1]+1;while(mod12(n)!==order[i])n++;notes.push(n);}if(notes[notes.length-1]<=limit&&notes[notes.length-1]-notes[0]<=14)out.push({notes,k});}}return out;};
  let c=build(79);if(!c.length)c=build(84);if(!c.length)c=[{notes:pcs.map((p,i)=>60+mod12(p-60)+(i?12:0)).sort((a,b)=>a-b),k:0}];
  if(!smooth||prevMean==null)return c.find(x=>x.k===0)||c[0];
  const target=prevMean;
  return c.reduce((best,x)=>{const m=x.notes.reduce((s,n)=>s+n,0)/x.notes.length;const d=Math.abs(m-target);return(!best||d<best.d)?{...x,d,m}:best;},null);
}
function flattenBars(song){const out=[];song.sections.forEach(sec=>sec.bars.forEach((b,i)=>out.push({chord:b,shift:sec.shift||0,section:sec.name,first:i===0})));return out;}
function buildPlan(song,shift,smooth){
  const k=keyInfo(song.key);let prev=null;
  return flattenBars(song).map(b=>{
    const c=parseChord(b.chord);const S=shift+b.shift;const root=mod12(c.root+S),bass=mod12(c.bass+S);
    const tonicT=mod12(k.tonic+S);const names=keyUsesFlats(tonicT,k.minor)?FLAT:SHARP;
    const rootName=names[root],bassName=names[bass];
    const v=voice(root,c.q,smooth,prev);prev=v.notes.reduce((s,n)=>s+n,0)/v.notes.length;
    const sp=spellChord(rootName,c.q,root);const byPc={};sp.forEach(x=>{byPc[x.pc]=x.name;});
    const label=(c.q==='maj7'?'maj7':c.q)||'';
    return{chord:b.chord,q:c.q,section:b.section,first:b.first,
      name:rootName+label+(c.slash?'/'+bassName:''),rootName,bassName,slash:c.slash,
      roman:romanFor(b.chord,k.tonic,k.minor),
      rh:v.notes,fingers:fingersFor(v.notes),inv:v.k,
      rhNames:v.notes.map(n=>(byPc[mod12(n)]||SHARP[mod12(n)])+(Math.floor(n/12)-1)),
      lh:48+bass,lhName:bassName+(Math.floor((48+bass)/12)-1),
      spelled:sp.map(x=>x.name)};
  });
}
/* melody helpers: bars are strings like "E4:1 D4:0.5 r:0.5" (note:beats) */
function parseNoteName(n){const m=/^([A-G])([#b]?)(\d)$/.exec(n);if(!m)throw new Error('bad melody note '+n);return 12*(+m[3]+1)+NOTE_PC[m[1]]+(m[2]==='#'?1:m[2]==='b'?-1:0);}
function parseMelodyBar(str){return String(str).trim().split(/\s+/).map(tok=>{const p=tok.split(':');const d=+p[1];if(!(d>0))throw new Error('bad duration '+tok);return p[0]==='r'?{name:null,midi:null,dur:d}:{name:p[0],midi:parseNoteName(p[0]),dur:d};});}
function melodyFinger(midi,tune){const wi=m=>Math.floor(m/12)*7+[0,0,1,1,2,3,3,4,4,5,5,6][mod12(m)];const d=wi(midi)-wi(tune.pos||60);if(d>=0&&d<=4)return d+1;const name=SHARP[mod12(midi)]+(Math.floor(midi/12)-1);return(tune.fingers&&tune.fingers[name])||null;}
/* rhythm feels: events in pulse units. pulse = quarter note (4/4, 3/4) or eighth (6/8). */
const FEELS={
 block:{name:"Block chords",meters:["4/4","3/4","6/8"],desc:"Left hand plays the bass note. Right hand plays the chord once on the beat and lets it ring."},
 pop:{name:"Steady pulse (pop)",meters:["4/4"],desc:"Left hand: the bass note on 1 and again on 3. Right hand: the chord on every beat, a little louder on 1 and 3. Count 1 2 3 4."},
 ballad:{name:"Ballad arpeggio",meters:["4/4","3/4","6/8"],desc:"Left hand: hold the bass note for the whole bar. Right hand: play the chord notes one at a time, low to high and back, in steady eighth notes. Count 1 & 2 & 3 & 4 &."},
 gospel:{name:"Gospel stabs",meters:["4/4"],desc:"Left hand: bass on 1 and 3. Right hand: short, punchy chords on 1, the 'and' of 2, 3, and the 'and' of 4. Count 1 (2) & 3 (4) &, keeping the gaps."},

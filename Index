const D={mode:null,active:false,n:0,score:0,max:0,q:null,ans:null,done:false,summary:null,diff:"easy"};
const rand=n=>Math.floor(Math.random()*n);
const pickOne=a=>a[rand(a.length)];
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=rand(i+1);const t=a[i];a[i]=a[j];a[j]=t;}return a;};

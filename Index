function chordLabel(root,q){return(keyUsesFlats(root,minorish(q))?FLAT:SHARP)[root]+(q==='maj7'?'maj7':q);}
function chordNotes(root,q){const names=keyUsesFlats(root,minorish(q))?FLAT:SHARP;return spellChord(names[root],q,root).map(x=>x.name).join(" – ");}
function playV(root,q,t,dur){voice(root,q,false,null).notes.forEach(n=>tone(n,t,dur,0.9,false));tone(36+mod12(root),t,dur,0.7,true);}
function genQ(){
  const id=D.mode;
  if(id==="quality"){const root=rand(12),cq=pickOne(["","m"]);return{root,cq,opts:["Major","Minor"],ans:cq===""?0:1};}
  if(id==="colour"){const root=rand(12),cq=pickOne(["","m","7","maj7"]);return{root,cq,opts:["Major","Minor","Dominant 7","Major 7"],ans:["","m","7","maj7"].indexOf(cq)};}
  if(id==="next"){const degs=[{n:"I",d:0,q:""},{n:"IV",d:5,q:""},{n:"V",d:7,q:""},{n:"vi",d:9,q:"m"}];const k=rand(4);return{tonic:rand(12),deg:degs[k],opts:degs.map(x=>x.n),ans:k};}
  if(id==="prog"){const correct=pickOne(PROGS);const opts=shuffle([correct].concat(shuffle(PROGS.filter(p=>p!==correct)).slice(0,3)));return{tonic:rand(12),prog:correct,opts:opts.map(o=>o.name),ans:opts.indexOf(correct)};}

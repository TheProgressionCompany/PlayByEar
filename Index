/* ---------- audio ---------- */
const A={ctx:null,master:null,playing:false,tid:0,raf:0,nextT:0,bar:0,countIn:0,events:[],ended:false,plan:null,m:null};
function newMaster(){const c=A.ctx;if(A.master){try{A.master.disconnect();}catch(e){}}const g=c.createGain();g.gain.value=0.9;const comp=c.createDynamicsCompressor();g.connect(comp);comp.connect(c.destination);A.master=g;}
function audio(){try{if(navigator.audioSession)navigator.audioSession.type="playback";}catch(e){}if(!A.ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;A.ctx=new C();newMaster();}if(A.ctx.state==="suspended")A.ctx.resume();return A.ctx;}
const freq=m=>440*Math.pow(2,(m-69)/12);
function tone(m,t,dur,vel,bass){
  const c=A.ctx;if(!c)return;const out=c.createGain();out.connect(A.master);
  const lp=c.createBiquadFilter();lp.type="lowpass";lp.frequency.value=bass?900:2600;lp.connect(out);
  const o1=c.createOscillator(),o2=c.createOscillator(),g2=c.createGain();
  o1.type="triangle";o2.type="sine";o1.frequency.value=freq(m);o2.frequency.value=freq(m)*2;g2.gain.value=0.3;
  o1.connect(lp);o2.connect(g2);g2.connect(lp);
  const peak=Math.max(0.001,vel*(bass?0.26:0.13));const d=Math.max(dur,0.12);
  out.gain.setValueAtTime(0.0001,t);out.gain.exponentialRampToValueAtTime(peak,t+0.01);
  out.gain.exponentialRampToValueAtTime(peak*0.4,t+Math.min(0.4,d*0.6));out.gain.exponentialRampToValueAtTime(0.0001,t+d);
  o1.start(t);o2.start(t);o1.stop(t+d+0.1);o2.stop(t+d+0.1);
}
function clickAt(t,vel){const c=A.ctx;const o=c.createOscillator(),g=c.createGain();o.type="square";o.frequency.value=vel>0.9?1500:1000;g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.05*vel,t+0.002);g.gain.exponentialRampToValueAtTime(0.0001,t+0.04);o.connect(g);g.connect(A.master);o.start(t);o.stop(t+0.06);}
function meterOf(s){const m=s.meter||"4/4";if(m==="6/8")return{pp:6,strikes:[0,3],beat:3};if(m==="3/4")return{pp:3,strikes:[0],beat:1};return{pp:4,strikes:[0,2],beat:1};}
const pulseDur=(s,speed)=>s.meter==="6/8"?60/(s.bpm*speed*3):60/(s.bpm*speed);
function scheduleBar(t,b,idx,s,m,pd,collect){
  const feel=activeFeel(s),mb=melBars(s),hasMel=!!(mb&&UI.melody);
  feelEvents(b,feel,m,!!mb).forEach(e=>{const tt=t+e.at*pd;e.notes.forEach(n=>tone(n,tt,e.dur*pd,e.vel,e.bass));});
  if(UI.click&&collect){for(let p=0;p<m.pp;p+=m.beat)clickAt(t+p*pd,p===0?1:0.5);}
  if(collect)A.events.push({t,bar:idx,mel:null});
  if(hasMel){let pos=0;mb[idx].forEach(n=>{if(n.midi!=null){const tt=t+pos*pd;tone(n.midi,tt,n.dur*pd*0.95,1,false);if(collect)A.events.push({t:tt,bar:idx,mel:n.midi});}pos+=n.dur;});}
}
function startPlay(){
  const c=audio();if(!c)return;stopPlay();const s=cur();
  A.plan=getPlan();A.m=meterOf(s);A.bar=UI.loop==="bar"?UI.bar:0;A.countIn=UI.click?1:0;A.nextT=c.currentTime+0.15;A.events=[];A.ended=false;A.playing=true;
  tick();A.raf=requestAnimationFrame(rafLoop);paintPlayBtn();
}
function tick(){
  if(!A.playing)return;const c=A.ctx,s=cur(),pd=pulseDur(s,UI.speed),m=A.m;
  while(A.nextT<c.currentTime+0.25&&!A.ended){
    if(A.countIn>0){for(let p=0;p<m.pp;p+=m.beat)clickAt(A.nextT+p*pd,p===0?1:0.55);A.countIn--;A.nextT+=m.pp*pd;continue;}
    A.plan=getPlan();const b=A.plan[A.bar];
    scheduleBar(A.nextT,b,A.bar,s,m,pd,true);
    A.nextT+=m.pp*pd;
    if(UI.loop!=="bar"){A.bar++;if(A.bar>=A.plan.length){if(UI.loop==="all")A.bar=0;else{A.ended=true;setTimeout(()=>{if(A.playing)stopPlay();},Math.max(0,(A.nextT-c.currentTime)*1000)+400);}}}

const DRILLS=[
 {id:"quality",name:"Major or minor?",blurb:"Hear one chord. Is it bright (major) or sad (minor)?",total:10},
 {id:"colour",name:"Chord colour",blurb:"Major, minor, dominant 7th or major 7th?",total:10},
 {id:"next",name:"Which chord comes next?",blurb:"Hear the home chord, then another. Which step of the scale is it?",total:10},
 {id:"prog",name:"Name that progression",blurb:"Hear four chords in a random key and name the pattern.",total:10},
 {id:"find",name:"Find the chords",blurb:"Hear a four-chord loop that starts on I. Pick the chords for bars 2, 3 and 4.",total:5}
